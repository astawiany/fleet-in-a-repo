# Single source of truth for tool and chart versions (shell-sourceable).
KIND_VERSION=0.30.0
CLUSTERCTL_VERSION=1.11.3
# cluster-api publishes no checksum file for clusterctl, so this sha256 of clusterctl-linux-amd64 is
# TRUST ON FIRST USE: computed once from a TLS download (it also equals the digest GitHub reports for
# the release asset). Recompute and review it whenever CLUSTERCTL_VERSION changes.
CLUSTERCTL_SHA256_LINUX_AMD64=d65ec7a42c36e863847103d48216c3dad248b82c447a27b3b2325a61e26ead9a
FLUX_VERSION=2.2.3 # matches the installed flux CLI; its embedded manifests are installed
HELM_VERSION=3.14.3
KUBECONFORM_VERSION=0.6.7
# Platform add-ons, verified 2026-11-03 (latest stable, mutually compatible, Kubernetes 1.34).
# Delivered to workload clusters as Flux postBuild variables (ConfigMap cluster-vars).
CERT_MANAGER_VERSION=1.21.3 # jetstack/cert-manager chart (tag v-prefixed); supports k8s 1.33-1.36
GATEWAY_API_VERSION=1.6.3 # standard channel; the version NGF 2.8.0 is built and tested against
NGF_VERSION=2.8.0 # oci://ghcr.io/nginx/charts/nginx-gateway-fabric; k8s >= 1.32
METALLB_VERSION=0.16.1 # metallb/metallb chart = MetalLB v0.16.1
KPS_VERSION=92.17.1 # prometheus-community/kube-prometheus-stack (operator v0.94.2)
# Node images: KIND_NODE_IMAGE is the kind 0.30.0 default (read from the kind binary).
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
# Workload clusters (CAPD) run kindest/node:<WORKLOAD_K8S_VERSION>.
WORKLOAD_K8S_VERSION=v1.34.0
# kindnet CNI image shipped inside the kindest/node image (/kind/manifests/default-cni.yaml).
# Tag only: the preloaded image has no repo digest (crictl: <none>), so a digest pin would
# force a registry pull; KIND_NODE_IMAGE's digest already pins it.
KINDNETD_IMAGE=docker.io/kindest/kindnetd:v20250512-df8de77b
PROMTOOL_IMAGE=prom/prometheus:v3.15.1@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2 # Prometheus version shipped by KPS_VERSION (non-distroless: has promtool)
# CI-only tool pins (scripts/ci-install-tools.sh); not needed for local runs.
KUBECTL_VERSION=1.34.0
KUSTOMIZE_VERSION=5.7.1
YQ_VERSION=4.44.3
# Release and security tooling (release.yml, validate.yml job security), looked up 2026-11-03 from the
# GitHub releases API. ci-install-tools.sh verifies each download against the checksum file published
# with the release (trivy's checksum file also by its Sigstore signature).
COSIGN_VERSION=3.1.4
# cosign is the root of trust for the other release tools, so its sha256 is also pinned here: the value
# in cosign_checksums.txt of v3.1.4, equal to the digest GitHub reports for the cosign-linux-amd64 asset
# (gh api repos/sigstore/cosign/releases/tags/v3.1.4, 2026-11-03). Update both together.
COSIGN_SHA256_LINUX_AMD64=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
TRIVY_VERSION=0.76.1
# govulncheck is `go install`ed inside BUILDER_IMAGE; the module is verified by the Go checksum database.
GOVULNCHECK_VERSION=1.9.0
# BuildKit for release.yml's docker-container buildx builder (attestations need it); pinned by digest.
BUILDKIT_IMAGE=moby/buildkit:v0.34.1@sha256:99368f3e46177c6405b9740e4461d91cee004128daeecca78d4ceac50ec1da5c
# SBOM generator BuildKit runs for --sbom (default would be the floating stable-1 tag). 1.12.1 is what
# stable-1 resolved to on 2026-11-03 (docker buildx imagetools inspect), pinned by that index digest.
SBOM_GENERATOR_IMAGE=docker/buildkit-syft-scanner:1.12.1@sha256:873a7458c3c8ac8e32c7b796c10e1600b07b963d2aa000a72a2d97aaaa2d6315
