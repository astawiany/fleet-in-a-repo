# Single source of truth for tool and chart versions (shell-sourceable).
KIND_VERSION=0.30.0
CLUSTERCTL_VERSION=1.11.3
FLUX_VERSION=2.2.3 # matches the installed flux CLI; its embedded manifests are installed
HELM_VERSION=3.14.3
KUBECONFORM_VERSION=0.6.7
CERT_MANAGER_VERSION=1.19.1 # TODO verify
GATEWAY_API_VERSION=1.4.0 # TODO verify
NGF_VERSION=2.2.0 # TODO verify
METALLB_VERSION=0.15.2 # TODO verify
KPS_VERSION=79.5.0 # TODO verify
# Node images: KIND_NODE_IMAGE is the kind 0.30.0 default (read from the kind binary).
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
# Workload clusters (CAPD) run kindest/node:<WORKLOAD_K8S_VERSION>.
WORKLOAD_K8S_VERSION=v1.34.0
# kindnet CNI image shipped inside the kindest/node image (/kind/manifests/default-cni.yaml).
KINDNETD_IMAGE=docker.io/kindest/kindnetd:v20250512-df8de77b
